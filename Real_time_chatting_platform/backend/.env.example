# Copy to .env and fill in. .env itself is gitignored.

# Supabase/Postgres DIRECT connection (port 5432), not the pooler.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

# HS256 signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 bytes — PyJWT warns below that.
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
